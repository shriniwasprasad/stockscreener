// ============================================================
// NIFTY 200 MOMENTUM 30 - SWING TRADING STRATEGY
// Based on: Investors Way Swing Trading Framework (Strategy 1)
// Timeframe : Daily
// Universe  : Apply on any Nifty 200 stock individually
// ============================================================
// EDUCATIONAL USE ONLY. NOT INVESTMENT ADVICE.
// ============================================================

//@version=5
indicator(
  title            = "Nifty200 Momentum Breakout - Investors Way",
  shorttitle       = "N200 Momentum",
  overlay          = true,
  max_labels_count = 200,
  max_lines_count  = 200
)

// ------------------------------------------------------------
// INPUTS
// ------------------------------------------------------------

grp1 = "Trend & Base Filters"
ema50_len   = input.int(50,  "50-DMA length",                 group = grp1)
ema200_len  = input.int(200, "200-DMA length",                group = grp1)
base_weeks  = input.int(6,   "Base rising look-back (weeks)", group = grp1)

grp2 = "Breakout Detection"
lookback_52w   = input.int(260,   "52-week high look-back (bars)",            group = grp2)
volume_mult_bo = input.float(2.0, "Volume multiplier - breakout day", step = 0.1, group = grp2)
vol_avg_len    = input.int(50,    "Volume average length",                    group = grp2)
near_pct       = input.float(3.0, "Near-breakout threshold (%)",    step = 0.5, group = grp2)
vol_near_len   = input.int(20,    "Volume avg - near-breakout compression",   group = grp2)

grp3 = "Volatility Filter"
atr_len     = input.int(14,    "ATR length",            group = grp3)
atr_min_pct = input.float(1.5, "ATR min % of price", step = 0.1, group = grp3)
atr_max_pct = input.float(5.0, "ATR max % of price", step = 0.1, group = grp3)

grp4 = "Trade Management"
risk_pct  = input.float(1.0,    "Risk per trade (% of capital)", step = 0.1,   group = grp4)
capital   = input.float(500000, "Total capital (Rs)",            step = 10000, group = grp4)
target1_r = input.float(1.5,    "Target 1 - R multiple",         step = 0.1,   group = grp4)
target2_r = input.float(3.0,    "Target 2 - R multiple",         step = 0.1,   group = grp4)
trail_ema = input.int(10,       "Trailing stop EMA length",                    group = grp4)
time_stop = input.int(15,       "Time stop (trading days)",                    group = grp4)

grp5 = "Display"
show_emas       = input.bool(true,  "Show 50 / 200 DMA",          group = grp5)
show_trail      = input.bool(true,  "Show trailing EMA (10)",      group = grp5)
show_52w_high   = input.bool(true,  "Show 52-week high line",      group = grp5)
show_atr_band   = input.bool(false, "Show ATR band on chart",      group = grp5)
show_labels     = input.bool(true,  "Show entry / exit labels",    group = grp5)
show_info_table = input.bool(true,  "Show info table (top right)", group = grp5)

// ------------------------------------------------------------
// CORE CALCULATIONS
// ------------------------------------------------------------

sma50         = ta.sma(close, ema50_len)
sma200        = ta.sma(close, ema200_len)
sma50_6w_ago  = ta.sma(close, ema50_len)[base_weeks * 5]
trail_ema_val = ta.ema(close, trail_ema)
atr14         = ta.atr(atr_len)
vol_avg50     = ta.sma(volume, vol_avg_len)
vol_avg20     = ta.sma(volume, vol_near_len)

high_52w   = ta.highest(high, lookback_52w)
high_52w_1 = ta.highest(high, lookback_52w)[1]

atr_pct = atr14 / close * 100

// ------------------------------------------------------------
// LAYER 1 - MARKET REGIME
// ------------------------------------------------------------

uptrend      = close > sma50 and close > sma200
golden_cross = sma50 > sma200
base_rising  = sma50 > sma50_6w_ago
regime_ok    = uptrend and golden_cross and base_rising

// ------------------------------------------------------------
// LAYER 2 - VOLATILITY FILTER
// ------------------------------------------------------------

atr_ok = atr_pct > atr_min_pct and atr_pct < atr_max_pct

// ------------------------------------------------------------
// LAYER 3 - BREAKOUT CONDITIONS
// ------------------------------------------------------------

// Case A: Fresh breakout - closed above 52-week high today with 2x volume
fresh_breakout = close > high_52w and
                 close[1] < high_52w_1 and
                 volume > volume_mult_bo * vol_avg50

// Case B: Near breakout - within near_pct% below high, volume compressing
near_level    = high_52w * (1 - near_pct / 100)
near_breakout = close >= near_level and
                close < high_52w and
                volume < vol_avg20

// Combined signals
signal_fresh = regime_ok and atr_ok and fresh_breakout
signal_near  = regime_ok and atr_ok and near_breakout

// ------------------------------------------------------------
// LAYER 4 - POSITION SIZING
// ------------------------------------------------------------

stop_price     = low
risk_per_trade = capital * (risk_pct / 100)
risk_per_share = math.max(close - stop_price, 0.01)
qty            = math.floor(risk_per_trade / risk_per_share)
position_val   = qty * close

t1_price = close + target1_r * risk_per_share
t2_price = close + target2_r * risk_per_share

// ------------------------------------------------------------
// LAYER 5 - TRADE MANAGEMENT
// ------------------------------------------------------------

// Trail stop: 2 consecutive closes below 10-EMA
trail_exit = close < trail_ema_val and close[1] < trail_ema_val[1]

// Time stop: count bars since last fresh breakout signal
var int bars_since_entry = na
if fresh_breakout
    bars_since_entry := 0
else if not na(bars_since_entry)
    bars_since_entry += 1

time_stop_hit = not na(bars_since_entry) and bars_since_entry == time_stop

// ------------------------------------------------------------
// PLOTS - MOVING AVERAGES
// ------------------------------------------------------------

plot(show_emas  ? sma50  : na, "50-DMA",        color = color.new(color.blue,   0), linewidth = 2)
plot(show_emas  ? sma200 : na, "200-DMA",       color = color.new(color.orange, 0), linewidth = 2)
plot(show_trail ? trail_ema_val : na, "10-EMA", color = color.new(color.purple, 20), linewidth = 1)

// ------------------------------------------------------------
// PLOTS - 52-WEEK HIGH LINE
// ------------------------------------------------------------

plot(show_52w_high ? high_52w : na, "52-week high", color = color.new(color.teal, 30), linewidth = 1, style = plot.style_stepline)

// ------------------------------------------------------------
// PLOTS - ATR BAND (optional)
// ------------------------------------------------------------

atr_upper = close + atr14
atr_lower = close - atr14
p_upper   = plot(show_atr_band ? atr_upper : na, "ATR upper", color = color.new(color.gray, 80))
p_lower   = plot(show_atr_band ? atr_lower : na, "ATR lower", color = color.new(color.gray, 80))
fill(p_upper, p_lower, color = color.new(color.gray, 92), title = "ATR band")

// ------------------------------------------------------------
// BACKGROUND SHADING
// ------------------------------------------------------------

bgcolor(signal_fresh ? color.new(color.green, 88) : na, title = "Fresh breakout bar")
bgcolor(signal_near  ? color.new(color.blue,  92) : na, title = "Near breakout bar")
bgcolor(trail_exit   ? color.new(color.red,   90) : na, title = "Trail stop bar")

// ------------------------------------------------------------
// LABELS
// ------------------------------------------------------------

if show_labels and signal_fresh
    lbl_txt = "BREAKOUT\nQty: " + str.tostring(qty) +
              "\nStop: "        + str.tostring(math.round(stop_price, 2)) +
              "\nT1: "          + str.tostring(math.round(t1_price,   2)) +
              "\nT2: "          + str.tostring(math.round(t2_price,   2))
    label.new(
      x         = bar_index,
      y         = low,
      text      = lbl_txt,
      style     = label.style_label_up,
      color     = color.new(color.green, 10),
      textcolor = color.white,
      size      = size.small
    )

if show_labels and signal_near
    label.new(
      x         = bar_index,
      y         = high,
      text      = "NEAR BREAKOUT\nGTT at " + str.tostring(math.round(high_52w, 2)),
      style     = label.style_label_down,
      color     = color.new(color.blue, 10),
      textcolor = color.white,
      size      = size.small
    )

if show_labels and trail_exit
    label.new(
      x         = bar_index,
      y         = high,
      text      = "TRAIL EXIT\n2 closes below 10-EMA",
      style     = label.style_label_down,
      color     = color.new(color.red, 10),
      textcolor = color.white,
      size      = size.small
    )

if show_labels and time_stop_hit
    label.new(
      x         = bar_index,
      y         = high,
      text      = "TIME STOP\n" + str.tostring(time_stop) + " days elapsed",
      style     = label.style_label_down,
      color     = color.new(color.orange, 10),
      textcolor = color.white,
      size      = size.small
    )

// ------------------------------------------------------------
// SHAPES
// ------------------------------------------------------------

plotshape(signal_fresh,  title = "Fresh breakout",  style = shape.triangleup,   location = location.belowbar, color = color.green,  size = size.small)
plotshape(signal_near,   title = "Near breakout",   style = shape.circle,       location = location.belowbar, color = color.blue,   size = size.tiny)
plotshape(trail_exit,    title = "Trail stop exit", style = shape.triangledown, location = location.abovebar, color = color.red,    size = size.small)
plotshape(time_stop_hit, title = "Time stop",       style = shape.xcross,       location = location.abovebar, color = color.orange, size = size.small)

// ------------------------------------------------------------
// INFO TABLE
// ------------------------------------------------------------

if show_info_table and barstate.islast
    var table t = table.new(
      position.top_right, 2, 12,
      bgcolor      = color.new(color.black, 75),
      border_color = color.new(color.gray,  60),
      border_width = 1,
      frame_color  = color.new(color.gray,  40),
      frame_width  = 1
    )

    table.cell(t, 0, 0, "N200 Momentum", text_color = color.white, text_size = size.small, bgcolor = color.new(color.teal, 30), text_halign = text.align_center)
    table.cell(t, 1, 0, "Status",        text_color = color.white, text_size = size.small, bgcolor = color.new(color.teal, 30), text_halign = text.align_center)

    table.cell(t, 0, 1, "Uptrend",       text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 1, uptrend      ? "Yes" : "No", text_color = uptrend      ? color.lime : color.red, text_size = size.small)

    table.cell(t, 0, 2, "Golden cross",  text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 2, golden_cross  ? "Yes" : "No", text_color = golden_cross  ? color.lime : color.red, text_size = size.small)

    table.cell(t, 0, 3, "Base rising",   text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 3, base_rising   ? "Yes" : "No", text_color = base_rising   ? color.lime : color.red, text_size = size.small)

    table.cell(t, 0, 4, "ATR %",         text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 4, str.tostring(math.round(atr_pct, 2)) + "%", text_color = atr_ok ? color.lime : color.orange, text_size = size.small)

    table.cell(t, 0, 5, "52W High",      text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 5, str.tostring(math.round(high_52w, 2)), text_color = color.white, text_size = size.small)

    signal_txt = signal_fresh ? "BREAKOUT" : signal_near ? "NEAR BKT" : "none"
    signal_col = signal_fresh ? color.lime  : signal_near ? color.aqua  : color.gray
    table.cell(t, 0, 6, "Signal",        text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 6, signal_txt,      text_color = signal_col,                text_size = size.small)

    table.cell(t, 0, 7, "Stop",          text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 7, str.tostring(math.round(stop_price, 2)),   text_color = color.white,               text_size = size.small)

    table.cell(t, 0, 8, "Qty",           text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 8, str.tostring(qty),                         text_color = color.white,               text_size = size.small)

    table.cell(t, 0, 9, "Position Rs",   text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 9, str.tostring(math.round(position_val, 0)), text_color = color.white,               text_size = size.small)

    table.cell(t, 0, 10, "T1",           text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 10, str.tostring(math.round(t1_price, 2)),    text_color = color.new(color.lime, 20), text_size = size.small)

    table.cell(t, 0, 11, "T2",           text_color = color.new(color.gray, 10), text_size = size.small)
    table.cell(t, 1, 11, str.tostring(math.round(t2_price, 2)),    text_color = color.new(color.lime, 10), text_size = size.small)

// ------------------------------------------------------------
// ALERTS
// ------------------------------------------------------------

alertcondition(signal_fresh,  title = "Fresh Breakout",   message = "{{ticker}} - Fresh 52-week high breakout with 2x volume. Check setup before entering.")
alertcondition(signal_near,   title = "Near Breakout",    message = "{{ticker}} - Within 3% of 52-week high, volume compressing. Set GTT alert.")
alertcondition(trail_exit,    title = "Trail Stop Exit",  message = "{{ticker}} - 2 consecutive closes below 10-EMA. Consider exiting position.")
alertcondition(time_stop_hit, title = "Time Stop Review", message = "{{ticker}} - 15 trading days since entry signal. Review if thesis still valid.")